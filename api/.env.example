# ==============================================================================
# SIFT (Safety Intelligence & Fatality-risk Tracking) - Environment Config
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME="SIFT - Safety Intelligence & Fatality-risk Tracking"
APP_VERSION=1.0.0
DEBUG=true

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# CORS Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Connection (Async driver required for SQLAlchemy async engine)
# For local SQLite fallback (instant zero-dependency dev/test):
DATABASE_URL=sqlite+aiosqlite:///./sift.db
# MongoDB report source of truth for the judge demo. This leaves the existing
# SQLite-backed non-report modules intact while reports use MongoDB.
# REPORT_STORAGE=mongodb
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DATABASE=sift
# REPORT_LOG_FILE=C:/Users/your-windows-user/report.txt
# For PostgreSQL (production/staging):
# DATABASE_URL=postgresql+asyncpg://sift_user:sift_password@localhost:5432/sift_db

# Security & JWT
SECRET_KEY=sift-super-secret-key-change-in-production-2026-oil-india
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Provider Configuration (mock, gemini, huggingface, openai)
AI_PROVIDER=mock
AI_CONFIDENCE_THRESHOLD=85
AI_MODEL_NAME=sift-nlp-precursor-v2.4
GEMINI_API_KEY=
OPENAI_API_KEY=

# Vector Storage Configuration (mock, pinecone)
VECTOR_STORE_PROVIDER=mock
EMBEDDING_PROVIDER=mock
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=sift-safety-reports
PINECONE_DIMENSION=1536
